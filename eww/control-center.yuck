(defvar end-notifications "")

(defpoll volume :interval "1s"
  "scripts/getvol")

(defpoll idle :interval "1s"
  "scripts/check-idle")

(defpoll vol_mute :interval "1s"
  "pactl get-sink-mute @DEFAULT_SINK@ | awk '{print $2}'")

(defpoll wifi_enabled :interval "1s"
  "nmcli radio wifi")

(defpoll bt_enabled :interval "1s"
  "systemctl status bluetooth | grep Status | awk '{print $2}'")

(defpoll brightness :interval "1s"
  "brightnessctl | grep Current | awk '{print $4}' | sed 's/[\(\)%]//g'")

(defwidget notification-card [notification]
  (eventbox :onclick "end close ${notification.id}"
	    :valign "start"
	    :height 100
	    :class "notification-card"
	    (box :orientation "v"
		 (label :text {notification.summary}
			:halign "start")
		 (label :text {notification.body}
			:halign "start"))))

(defwidget header []
  (box :orientation "h"
	time))

(defwidget control_metric [label value onchange]
  (box :orientation "h"
       :class "control-metric"
       :space-evenly false
    (box :class "label"
	label)
	(scale :min 0
           :max 101
           :active {onchange != ""}
           :value value
           :onchange onchange
	   :orientation "h"
	   :flipped false
	   :width "275"
	   :halign "end")
    ))

(defwidget toggle_control [active-label inactive-label active onclick]
  (button :class {active == true ? "toggle toggle-active" : " toggle toggle-inactive"}
       :onclick onclick
       {active ? active-label : inactive-label}))

(defwidget toggle_controls []
  (box :orientation "h"
       :space-evenly true
       :spacing 44
       :class "toggle-controls"
  (toggle_control :inactive-label ""
                  :active-label "🔊"
		  :active {vol_mute != "yes"}
		  :onclick "")
  (toggle_control :active-label "󰤨"
                  :inactive-label "󰤭"
		  :active {wifi_enabled == "enabled"}
		  :onclick "")
  (toggle_control :active-label "󰂯"
                  :inactive-label "󰂲"
		  :active {bt_enabled == '"Running"'}
		  :onclick "")
  (toggle_control :active-label ""
                  :inactive-label ""
		  :active {idle == 0}
		  :onclick "scripts/toggle-idle")
  ))

(defwidget adjustable_controls []
    (box :orientation "v"
    (control_metric :label {vol_mute == "yes" ? " " : "🔊" }
          :value volume
          :onchange "amixer -D pulse sset Master {}%")
    (control_metric :label "󰃠 "
          :value brightness
          :onchange "brightnessctl set {}%")))

(defwidget sys_stat [label value]
  (overlay :class "sys-stat"
       (circular-progress :value value
			  :start-at 75
			  :thickness 5
			  :clockwise true)
	label))

(defwidget sys_info []
  (box :orientation "h"
       :spaced-evenly true
       :class "sys-info"
       (sys_stat :label ""
		 :value {EWW_CPU.avg})
       (sys_stat :label ""
		 :value {EWW_RAM.used_mem_perc})
       (sys_stat :label "💾"
		 :value {EWW_DISK["/"].used_perc})
       (sys_stat :label "󰁹"
		 :value {EWW_BATTERY["BAT1"].capacity})))

(defwidget control_card []
  (box :class "control-card"
       :orientation "v"
       (toggle_controls)
       (adjustable_controls)
       (sys_info)))

(defwidget notifications []
  (box :class "notifications"
       (literal :content end-notifications)))

(defwidget control_center []
  (box :class "control-center"
       :orientation "v"
       :space-evenly false
	(header)
	(control_card)
	(notifications)))

(defwindow control_center
  :monitor 0
  :stacking "fg"
  :geometry (geometry :x "2px"
		      :y "5px"
		      :width "300px"
		      :height "100%"
		      :anchor "top right")
  (control_center))
