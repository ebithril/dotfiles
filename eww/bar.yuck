(include "control-center.yuck")

(defpoll current_workspace :interval "100ms"
  "hyprctl activeworkspace | grep -oP '(?<=workspace ID )\\d+'")

(defpoll time :interval "10s"
  "date '+%H:%M %b %d, %Y'")

(defwidget bar []
  (centerbox :orientation "h"
    (workspaces)
    (music)
    (sidestuff)))

(defwidget sidestuff []
  (box :class "sidestuff" :orientation "h" :space-evenly false :halign "end"
    time))

(defwidget workspaces []
  (box :class "workspaces"
       :orientation "h"
       :space-evenly true
       :halign "start"
       :spacing 15
  (for workspace in workspaces
      (button 
        :class {workspace.id == current_workspace ? "active" : "inactive"}
        :onclick "hyprctl dispatch workspace ${workspace.id}"
	{workspace.icon}))))


(defvar workspaces '[
  {"id": 1, "icon": ""},
  {"id": 2, "icon": ""},
  {"id": 3, "icon": ""},
  {"id": 4, "icon": ""},
  {"id": 5, "icon": ""},
  {"id": 6, "icon": ""},
  {"id": 7, "icon": ""},
  {"id": 8, "icon": ""},
  {"id": 9, "icon": ""}
]')


(defwidget music []
  (box :class "music"
       :orientation "h"
       :space-evenly false
       :halign "center"
    {music != "" ? "🎵 ${music}" : ""}))

(deflisten music :initial ""
  "playerctl --follow metadata --format '{{ artist }} - {{ title }}' || true")


(defwindow bar
  :exclusive true
  :monitor 0
  :stacking "fg"
  :geometry (geometry :x "0%"
                      :y "0%"
                      :width "100%"
                      :height "25px"
                      :anchor "top center")
  (bar))

